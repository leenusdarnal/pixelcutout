{
  "name": "pixelcutout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "npm run test && npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test",
    "benchmark:validate": "node benchmarks/validate-manifest.mjs",
    "benchmark:generate:synthetic": "python benchmarks/generate_synthetic.py",
    "benchmark:score:alpha": "python benchmarks/evaluate_alpha.py",
    "benchmark:compare:alpha": "python benchmarks/compare_alpha_scorecards.py",
    "benchmark:browser:dev": "vite --config benchmarks/browser/vite.config.ts --host 0.0.0.0",
    "benchmark:browser:build": "vite build --config benchmarks/browser/vite.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
